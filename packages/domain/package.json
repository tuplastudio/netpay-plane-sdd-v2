{
  "name": "@netpay/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Modelos de dominio compartidos (lógica pura, sin I/O)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@netpay/contracts": "workspace:*"
  },
  "devDependencies": {
    "@netpay/config": "workspace:*",
    "eslint": "9.17.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
