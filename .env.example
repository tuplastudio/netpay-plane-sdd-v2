# Variables de entorno - NetPay Plane
# Solo referencias a secretos gestionados, nunca valores reales.
#
# Plantilla: copia a `.env` (desarrollo local con compose) o a
# `infra/.env.prod` (Droplet). Los nombres en MAYÚSCULAS_SNAKE_CASE
# también sirven como `env_file:` en los Dockerfiles — el underscore es
# la convención de Node, NestJS, Prisma, Next, FastAPI.

# ---- Aplicación ----
APP_ENV=local
NODE_ENV=development
# URL pública del frontend (enlaces de pago y cotización que el agente
# manda al cliente; CORS del API). En prod = tu dominio con HTTPS.
PUBLIC_BASE_URL=http://localhost:3000
# Origen público del API (sin /api/v1). Evolution registra aquí el webhook de
# WhatsApp en el alta automática desde /channels, así que en prod debe ser el
# dominio estable del API (https://api.tu-dominio.com), nunca un túnel
# efímero. Vacío = cae a PUBLIC_BASE_URL (el web reescribe /api/v1/* al API).
API_PUBLIC_URL=
# URL con la que el dummy-gateway alcanza a ESTE API para avisar por webhook
# que un pago se cobró (ver apps/commerce-api/src/payments/payment.service.ts
# createCheckout). Por defecto cae a PUBLIC_BASE_URL, así que si esa apunta a
# un túnel (ngrok, para probar webhooks de WhatsApp) hay que fijar esta
# explícita o el webhook de pagos se manda al túnel y los pedidos se quedan
# sin marcar como pagados.
API_SELF_URL=http://localhost:4000

# ---- Base de datos negocio ----
# Local: docker compose levanta Postgres en :15432.
# Prod: el connection string viene de Neon (ver docs/DEPLOY_DIGITALOCEAN.md).
#   Formato típico:
#     postgresql://<user>:<password>@<project>.neon.tech/neondb?sslmode=require
#   IMPORTANTE: añadir `?sslmode=require` y `?pgbouncer=true` si usas el
#   pooler (Neon lo recomienda cuando Prisma abre muchas conexiones).
DATABASE_URL=postgresql://netpay_app:netpay_app@localhost:15432/netpay?schema=public
DATABASE_URL_DUMMY=postgresql://netpay_dummy:netpay_dummy@localhost:15433/netpay_dummy?schema=public
# Neon: connection pooler para el serverless del agente y el de commerce-api
# (cada plano de Neon aguanta mejor pooler que sesiones directas).
#   DATABASE_POOL_URL=postgresql://...@<project>-pooler.neon.tech/neondb?sslmode=require

# ---- Broker (RabbitMQ) ----
# Local: docker compose levanta RabbitMQ en :5672.
# Prod: amqps://<user>:<password>@<host>.cloudamqp.com/<vhost> (CloudAMQP);
#   el `vhost` suele ser el mismo nombre de usuario.
BROKER_URL=amqp://netpay:netpay@localhost:5672
CONSUMER_GROUP=commerce-worker
CONSUMER_PATTERNS=#
CONSUMER_PREFETCH=10

# ---- Almacenamiento de objetos (S3 compatible) ----
# Local: docker compose levanta MinIO en :9000.
# Prod: DigitalOcean Spaces:
#   OBJECT_STORAGE_ENDPOINT=https://<region>.digitaloceanspaces.com
#   OBJECT_STORAGE_ACCESS_KEY=...
#   OBJECT_STORAGE_SECRET_KEY_REF=do_spaces_secret
#   OBJECT_STORAGE_BUCKET=netpay-attachments
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=netpay-attachments
OBJECT_STORAGE_ACCESS_KEY=netpay_minio
OBJECT_STORAGE_SECRET_KEY_REF=object_storage_secret

# ---- Sesión y cifrado ----
SESSION_SECRET_REF=session_secret_change_me_64_chars_minimum_pad_pad_pad_pad
TOKEN_ENCRYPTION_KEY_REF=token_encryption_key_change_me_32_bytes

# ---- Pasarela de pagos (DUMMY OBLIGATORIO) ----
PAYMENT_PROVIDER=DUMMY
DUMMY_BASE_URL=http://localhost:4100
# URL pública del checkout hosted que el navegador del cliente abre. En prod
# se sirve vía /pay/* del frontend (Vercel proxy → commerce-api → dummy).
# El valor por defecto cae al DUMMY_BASE_URL, lo cual funciona en local
# (cliente y gateway en el mismo browser) pero NO en prod.
# Prod: https://tu-dominio.com/pay (route handler apps/web/src/app/pay/).
DUMMY_PUBLIC_URL=http://localhost:4100
# Métodos de pago que ve el cliente en el checkout hosted, separados por
# coma: CARD (tarjeta), SPEI (transferencia), OXXO (efectivo). Vacío = todos.
PAYMENT_METHODS=CARD,SPEI,OXXO
# Service key con la que commerce-api se presenta ante el gateway. El gateway
# la exige si arranca con la misma variable; en local puede ir vacía.
DUMMY_SERVICE_KEY_REF=dummy_service_key
DUMMY_WEBHOOK_SECRET_REF=dummy_webhook_secret

# ---- WhatsApp: Meta oficial ----
META_APP_ID=
META_APP_SECRET_REF=meta_app_secret
META_VERIFY_TOKEN_REF=meta_verify_token

# ---- WhatsApp: Evolution/Baileys ----
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY_REF=evolution_api_key

# ---- IA (OpenRouter) ----
# Sin OPENROUTER_KEY_REF el agente sigue conversando con su motor determinista.
OPENROUTER_KEY_REF=openrouter_key
MODEL_ID=openai/gpt-4o-mini
MODEL_ID_FALLBACK=anthropic/claude-3.5-haiku
STT_MODEL_ID=openai/whisper-1
TTS_MODEL_ID=openai/tts-1
TTS_VOICE=alloy
AGENT_TEMPERATURE=0.55
AGENT_MAX_TOKENS=700

# ---- Agente: acceso al backend comercial ----
# Fallback legacy para un despliegue de un solo tenant. En modo multi-tenant,
# agent-v2 firma cada llamada con AGENT_INTERNAL_KEY y el tenant del turno.
COMMERCE_API_URL=http://localhost:4000/api/v1
# Base pública del API para URLs absolutas de archivos subidos (logo de la
# empresa, servido en <API_PUBLIC_URL>/uploads/...). Opcional: si falta se
# deriva de COMMERCE_API_URL sin el sufijo /api/v1. Detrás de un reverse proxy
# ponla explícita (p. ej. https://api.midominio.com).
# API_PUBLIC_URL=http://localhost:4000
# Carpeta en disco donde el API guarda los archivos subidos (default:
# apps/commerce-api/uploads, ignorada por git). Monta un volumen en producción.
# UPLOADS_DIR=./uploads
AGENT_API_KEY_REF=
# Agente activo (v2) visto desde commerce-api. En host con `pnpm dev` es
# localhost:8010; dentro de Docker, el nombre de servicio http://agent-v2:8010.
# Si apunta a un host que no resuelve, todo lo que commerce-api le pide al
# agente falla en silencio: el filtro de moderación se vuelve permisivo y el
# autocierre de conversaciones nunca lee los ajustes, así que no cierra nada.
AGENT_URL=http://localhost:8010
AGENT_AUTOREPLY=true

# ---- Agente: autenticación de servicio a servicio ----
# Compartida entre agent-service, commerce-api (AgentBridgeService) y web
# (proxy en src/app/agent/[...path]/route.ts). Sin valor, el agente queda
# abierto a cualquiera que alcance el puerto: OBLIGATORIA fuera de un
# laptop de desarrollo. Mismo valor en los tres servicios.
AGENT_INTERNAL_KEY_REF=
# apps/web y apps/commerce-api leen la variable sin sufijo _REF (fetch
# directo, no gestor de secretos todavía); agent-service acepta ambas.
AGENT_INTERNAL_KEY=
AGENT_INTERNAL_URL=http://localhost:8000
# Llave de cifrado de los secretos por tenant guardados en settings/*.json
# (ej. la OpenRouter API key de cada tenant). 32 bytes mínimo (ver
# apps/agent-v2/app/agent_settings.py _encrypt).
# AGENT_SECRET_KEY=

# ---- Agente: conocimiento del negocio y estado ----
KNOWLEDGE_DIR=apps/agent-service/knowledge
KNOWLEDGE_TOP_K=4
AGENT_CHECKPOINT_DIR=apps/agent-service/.checkpoints
AGENT_CHECKPOINT_ENABLED=true

# ---- Agente: presupuestos por turno ----
AGENT_MAX_TOOL_STEPS=8
AGENT_TURN_BUDGET_SECONDS=30
AGENT_MAX_INPUT_CHARS=8000
AGENT_HISTORY_WINDOW=12
AGENT_SUMMARIZE_AFTER=20
AGENT_MAX_COST_USD=1.0
AGENT_MAX_AUDIO_BYTES=8388608

# ---- API comercial ----
API_PORT=4000
WORKER_PORT=4101
AGENT_PORT=8000
DUMMY_PORT=4100
WEB_PORT=3000

# ---- Rate limits por defecto ----
RATE_LIMIT_API_KEY=120
RATE_LIMIT_PUBLIC_READ=60
RATE_LIMIT_CHECKOUT=5
