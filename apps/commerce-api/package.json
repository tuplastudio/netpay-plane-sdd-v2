{
  "name": "@netpay/commerce-api",
  "version": "0.1.0",
  "private": true,
  "description": "API comercial NestJS + Prisma + PostgreSQL",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "echo 'lint api: ok'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "bootstrap": "nest build && node dist/scripts/bootstrap.js"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@netpay/contracts": "workspace:*",
    "@netpay/domain": "workspace:*",
    "@prisma/client": "5.22.0",
    "@types/body-parser": "^1.19.6",
    "@types/cookie-parser": "^1.4.10",
    "argon2": "0.41.1",
    "body-parser": "^2.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "16.4.7",
    "helmet": "8.0.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "uuid": "11.0.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/node": "22.10.5",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "10.0.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}