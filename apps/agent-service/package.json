{
  "name": "@netpay/agent-service",
  "version": "0.1.0",
  "private": true,
  "description": "Agente IA conversacional (FastAPI + OpenRouter)",
  "scripts": {
    "dev": "./.venv/bin/uvicorn app.main:app --reload --port ${AGENT_PORT:-8000}",
    "start": "./.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${AGENT_PORT:-8000}",
    "test": "./.venv/bin/python -m pytest -q",
    "evals": "./.venv/bin/python -m app.evals",
    "typecheck": "./.venv/bin/python -m compileall -q app && echo 'typecheck agent: ok'"
  }
}
