{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @netpay/web build",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "fix/password-recovery-hardening": true
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "${API_INTERNAL_URL}/api/v1/:path*"
    }
  ]
}
