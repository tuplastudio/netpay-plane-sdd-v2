{
  "name": "atiendeya-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP sobre la API de Atiende ya: catálogo, clientes, cotizaciones, pedidos, pagos, envíos, reportes, notificaciones, integraciones y conversaciones de WhatsApp, autenticado con tu API key de tenant.",
  "keywords": ["mcp", "model-context-protocol", "atiendeya", "whatsapp", "ecommerce"],
  "license": "MIT",
  "author": "Tupla (https://tupla.dev)",
  "type": "module",
  "engines": { "node": ">=18" },
  "files": ["dist", "README.md"],
  "bin": {
    "atiendeya-mcp": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@netpay/config": "workspace:*",
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
